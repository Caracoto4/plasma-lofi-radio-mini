[Unit]
Description=Publish the track lofiradio.ru is playing (for the Lofi Radio Mini widget)
Documentation=https://lofiradio.ru
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=0

[Service]
Type=simple
ExecStart=/usr/bin/python3 %h/.local/share/lofi-radio-mini/lofi-nowplaying.py
Restart=always
RestartSec=5
NoNewPrivileges=yes
Nice=10
# Для доступа к notify-send через DBus
Environment=DBUS_SESSION_BUS_ADDRESS=unix:path=/run/user/%U/bus
# PATH для доступа к системным командам (git, rm, chmod, systemctl)
Environment=PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin

[Install]
WantedBy=default.target
